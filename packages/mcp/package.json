{
  "name": "trust-ledger-os-mcp",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "MCP-ready package surface for Trust Ledger OS tools and resources.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "trust-ledger-os-mcp": "./dist/server.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
